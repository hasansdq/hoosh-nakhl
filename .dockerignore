# =============================================================================
# Nakhl Restaurant — Docker build context exclusions
# -----------------------------------------------------------------------------
# Everything the image needs comes from: package.json + bun.lock, prisma/,
# src/, public/, migrations/, seed/, next.config.ts, tsconfig.json,
# postcss/biome/eslint configs, and the docker/ runtime scripts below.
# =============================================================================

# --- VCS / meta ---
.git
.gitignore
*.md

# --- local tooling & secrets (NEVER bake into an image) ---
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
docker/env.example

# --- dependency & build artifacts (rebuilt inside the image) ---
node_modules
.next
.open-next
.wrangler
tsconfig.tsbuildinfo
next-env.d.ts

# --- sandbox-only services & platform scripts ---
mini-services
.zscripts
agent-ctx
skills
examples
qa
download
tool-results
dev.log
*.log

# --- runtime data (belongs to the volume, not the image) ---
db
docker/backups
# host-side backup snapshots (docker/backup.sh writes ./backups on the VPS) —
# full database copies with PII/password hashes/API keys: NEVER into the build
# context (they would land in builder-stage layers and bloat the context)
backups
# sandbox artifacts (uploaded reference files)
upload

# --- misc repo files not needed at runtime ---
scripts
Caddyfile
Caddyfile.prod
wrangler.jsonc
wrangler.toml
open-next.config.ts
.dev.vars.example
.dockerignore
docker-compose.yml
Dockerfile
# legacy Node-kit artifacts (pre-DirectAdmin architecture — see DEPLOY-FA.md banner)
deploy
tests
