# Build context is the repository root — keep the image small and hermetic.
# (Sandbox/dev artifacts must never leak into the production image.)

# VCS + platform internals
.git
.gitignore
.zscripts
agent-ctx
skills
examples
tests
tool-results
qa
download
upload

# dependencies & build output (rebuilt inside the image)
**/node_modules
.next
db

# local config / secrets (compose + .env.example drive production config)
.env
.env.*
!.env.example
Caddyfile
Caddyfile.prod
docker-compose.yml

# runtime artifacts & docs
*.log
dev.log
server.log
worklog.md
DEPLOY-FA.md
deploy

# misc
--full-page
*.md
.DS_Store
