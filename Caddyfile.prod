# =============================================================================
# Nakhl Restaurant — production Caddy configuration
# -----------------------------------------------------------------------------
# Caddy terminates TLS (automatic Let's Encrypt), then routes:
#   • /rt/*   → notify-service :3003  (socket.io — prefix stripped; the service
#              itself serves engine.io on "/") — polling AND WebSocket
#   • everything else → Next.js standalone :3000
#
# The site address comes from the DOMAIN env var (docker-compose.yml):
#   DOMAIN=nakhl.example.com        → automatic HTTPS + HTTP→HTTPS redirect
#   DOMAIN=http://localhost:8080    → plain HTTP local trial (no TLS)
# =============================================================================

{$DOMAIN} {
	encode zstd gzip

	# ---- realtime channel (socket.io) ----
	handle /rt/* {
		uri strip_prefix /rt
		reverse_proxy notify:3003
	}

	# ---- Next.js app (API + SSR + static) ----
	handle {
		reverse_proxy web:3000
	}

	# ---- security headers ----
	header {
		# only meaningful over HTTPS; Caddy only sets it on TLS connections
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
