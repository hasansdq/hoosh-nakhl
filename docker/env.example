# =============================================================================
# Nakhl Restaurant — Docker/VPS environment reference
# -----------------------------------------------------------------------------
# کپی کنید به ریشهٔ پروژه:   cp docker/env.example .env
# (docker-compose.yml همین یک فایل .env ریشه را هم برای متغیرهای جایگزینی
#  مثل NAKHL_PORT و هم برای environment کانتینر استفاده می‌کند.)
#
# قواعد امنیتی:
#  • هیچ‌وقت فایل .env را commit نکنید (در .gitignore و .dockerignore هست).
#  • ADMIN_PASSWORD فقط «یک بار» در اولین بوت خوانده می‌شود؛ اگر خالی
#    بمانید، رمز تصادفی قوی تولید و در data/initial-admin-credentials.txt
#    (داخل volume، با دسترسی 600) ذخیره می‌شود. بعد از اولین ورود از پنل
#    /nk-admin رمز را عوض کنید.
#  • ADMIN_NOTIFY_KEY اگر خالی باشد، در اولین بوت تولید و در
#    data/secrets.env ذخیره می‌شود تا در ری‌دیپلوی‌ها ثابت بماند.
# =============================================================================

# ---------- شبکه ----------
# پورت میزبانِ کانتینر (فقط روی 127.0.0.1 منتشر می‌شود؛ آپاچیِ دایرکت‌ادمین
# همین پورت را پراکسی می‌کند — پورت‌های 80/443 متعلق به دایرکت‌ادمین است):
NAKHL_PORT=8080

# منطقهٔ زمانی کانتینر (تاریخ‌ها و گزارش‌ها):
TZ=Asia/Tehran

# ---------- مدیر (فقط اولین بوت) ----------
# اگر ADMIN_PASSWORD خالی باشد → رمز تصادفی تولید و در
# data/initial-admin-credentials.txt ذخیره می‌شود (recommended).
ADMIN_USERNAME=nakhl-admin
ADMIN_PASSWORD=

# ---------- Realtime ----------
# کلید مشترک کانال اعلان‌ها؛ خالی = تولید خودکار و ذخیره در data/secrets.env
# (پشت Apache هیچ‌وقت از بیرون قابل مشاهده نیست):
ADMIN_NOTIFY_KEY=

# ---------- پرداخت — «کیل‌سوییچ» امنیتی (پیش‌فرض: فعال) ----------
# ZARINPAL_FORCE_REAL=1 شبیه‌سازی دروازهٔ پرداخت را برای همیشه قفل می‌کند:
#   • مسیر /api/payment/simulate برای همه ۴۰۳ می‌دهد (کاملاً مرده)
#   • زرین‌پال هرگز authority آزمایشی (SIM-…) نمی‌سازد
#   • سفارش‌ها فقط از دروازهٔ واقعی با «مرچنت‌آیدی» تنظیم‌شده در پنل مدیریت
#     (تنظیمات ← پرداخت) قابل پرداخت‌اند — بدون مرچنت، سفارش با خطای واضح
#     متوقف می‌شود؛ هرگز «پرداخت موفق» جعلی اتفاق نمی‌افتد.
# ⚠️ این مقدار فقط در سرور استیجینگ خصوصی و برای تست به ۰ تغییر دهید.
# (docker-compose حتی بدون این خط هم پیش‌فرض ۱ را اعمال می‌کند — اینجا برای
#  شفافیت نوشته شده است.)
ZARINPAL_FORCE_REAL=1

# ---------- سیدینگ ----------
# prod = تنظیمات امن پروداکشن (OTP واقعی، پرداخت واقعی) — پیش‌فرض
# dev  = فقط برای استیجینگ/تست (کد OTP در پاسخ API نمایش داده می‌شود!)
NAKHL_SEED_PROFILE=prod

# ---------- بک‌اپ ----------
# تعداد snapshot نگه‌داشته‌شده در data/backups (اجرای خودکار: docker/backup.sh):
NAKHL_BACKUP_KEEP=14
