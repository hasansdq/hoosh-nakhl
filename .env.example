# =============================================================================
# رستوران نخل — نمونهٔ متغیرهای محیطی پروداکشن (Nakhl Restaurant .env.example)
# -----------------------------------------------------------------------------
# یک کپی از این فایل با نام «.env» بسازید و مقادیر را برای سرور خود تنظیم کنید:
#     cp .env.example .env
#
# ⚠️ فایل .env را هرگز commit نکنید (در .gitignore مسدود شده است).
# ⚠️ مقادیر پیش‌فرض فقط برای توسعه (development) هستند — در پروداکشن حتماً
#    رمزها/کلیدهای قوی و یکتا جایگزین کنید.
# =============================================================================

# ---------- Domain / دامنه ----------
# دامنهٔ سایت (برای صدور خودکار SSL توسط Caddy). برای تست محلی بدون دامنه:
# DOMAIN=http://localhost
DOMAIN=nakhl.example.com

# ---------- Database / پایگاه داده (SQLite) ----------
# مسیر فایل دیتابیس. در Docker به‌صورت volume (db_data) نگهداری می‌شود.
# ❗ مسیر باید مطلق (absolute) باشد.
DATABASE_URL=file:/app/db/custom.db

# ---------- Security / امنیت ----------
# رمز امضای session ها — یک رشتهٔ تصادفی طولانی (مثلاً خروجی: openssl rand -hex 32)
# ⚠️ اگر تغییر دهد، همهٔ session های کاربران و ادمین باطل می‌شوند.
AUTH_SECRET=CHANGE-ME-openssl-rand-hex-32

# کلید مشترک احرازیهٔ سرویس نوتیفیکیشن (بین web و notify یکسان باید باشد)
ADMIN_NOTIFY_KEY=CHANGE-ME-strong-random-key

# ---------- Admin bootstrap / ادمین اولیه (seed) ----------
# فقط هنگام seed اولیهٔ دیتابیس استفاده می‌شود (docker/entrypoint.sh → prisma/seed.ts)
# ⚠️ بعد از اولین ورود، رمز را از داخل پنل مدیریت تغییر کنید.
ADMIN_USERNAME=rayantech
ADMIN_PASSWORD=CHANGE-ME-strong-admin-password

# ---------- Payment / پرداخت زرین‌پال ----------
# 1 = قطع‌کنندهٔ اضطراری درگاه شبیه‌سازی؛ در پروداکشن حتماً 1 بگذارید تا پرداخت
# فقط از درگاه واقعی زرین‌پال عبور کند (مرچنت‌آی‌دی را در پنل مدیریت وارد کنید).
ZARINPAL_FORCE_REAL=1

# ---------- Realtime / اتصال socket.io ----------
# آدرس سرویس notify از دید بک‌اند Next.js (در Docker: نام سرویس).
NAKHL_NOTIFY_URL=http://notify:3003/emit

# ---------- Realtime supervisor (فقط سندباکس z.ai) ----------
# 1 = نگهداری خودکار dev server توسط notify-service (مخصوص سندباکس).
# در پروداکشن باید 0 باشد یا کلاً حذف شود (با NODE_ENV=production خودکار خاموش می‌شود).
NAKHL_SUPERVISE_DEV=0

# ---------- Development-only flags (اختیاری) ----------
# 1 = نمایش مجدد کد OTP در پاسخ API برای تست روی سرور پروداکشن (خطرناک — فقط تست موقت)
# NAKHL_EXPOSE_DEV_CODE=0

# ---------- Build-time (Docker build args — معمولاً نیاز به تغییر نیست) ----------
# مسیر socket.io که در بیلد در client کد می‌شود (Caddyfile.prod همان /rt را پروکسی می‌کند)
NEXT_PUBLIC_SOCKET_PATH=/rt

# ---------- Runtime server (standalone server.js) ----------
PORT=3000
HOSTNAME=0.0.0.0

# توضیح: تنظیمات SMS (ملی‌پیامک / SMS.IR)، AI (OpenAI / OpenRouter) و زرین‌پال
# (مرچنت‌آی‌دی، sandbox و …) از داخل «پنل مدیریت → تنظیمات» و در دیتابیس نگهداری
# می‌شوند و نیازی به متغیر محیطی ندارند. فقط provider هوش مصنوعی «zai» مخصوص
# سندباکس z.ai است — در پروداکشن از OpenRouter یا OpenAI استفاده کنید.
