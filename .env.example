# ─────────────────────────────────────────────────────────────────────────────
#  Nakhl Restaurant — environment reference (Cloudflare Workers edition)
# ─────────────────────────────────────────────────────────────────────────────
#  این فایل فقط مستند است. مقادیر واقعی هرگز commit نمی‌شوند.
#
#  جدول محیط‌ها:
#   • `next dev` (سندباکس/لوکال)  → فایل .env  (این فایل را کپی کنید)
#   • `wrangler dev` (پیش‌نمایش لوکال بیلد CF) → فایل .dev.vars (کپی از .dev.vars.example)
#   • پروداکشن (Workers)         → wrangler.jsonc `vars` + `wrangler secret put …`
#
#  دیتابیس و فایل‌ها در مسیر Cloudflare به صورت binding متصل می‌شوند (D1 + R2)
#  و نیازی به DATABASE_URL یا مسیر فایل محلی ندارند — این موارد فقط برای
#  ابزارهای CLI پراسما هستند.
# ─────────────────────────────────────────────────────────────────────────────

# ---------- فایل .env برای `next dev` (لوکال) ----------

# لازم نیست DATABASE_URL را برای اجرای اپ تنظیم کنید — اپ از binding «DB»
# (Miniflare محلی با state در .wrangler/state) استفاده می‌کند. این مقدار فقط
# برای ابزار CLI پراسما (generate / migrate diff) است:
DATABASE_URL=file:./db/custom.db

# کلید مشترک کانال اعلان real-time (در لوکال: سرویس Socket.IO سندباکس):
ADMIN_NOTIFY_KEY=nakhl-notify-2024

# آدرس سرویس notify در حالت توسعه (پیش‌فرض همان است):
# NAKHL_NOTIFY_URL=http://localhost:3003/emit

# مسیر socket.io پشت reverse-proxy در حالت self-host dev (در Cloudflare استفاده نمی‌شود):
# NEXT_PUBLIC_SOCKET_PATH=/rt

# ---------- فایل .dev.vars برای `wrangler dev` (پیش‌نمایش لوکال بیلد) ----------
# کپی از .dev.vars.example — همان ADMIN_NOTIFY_KEY و موارد اختیاری زیر.

# ---------- پروداکشن: wrangler.jsonc + secrets ----------
# در wrangler.jsonc فقط متغیرهای غیرحساس (vars) قرار می‌گیرند. برای اسرار:
#   wrangler secret put ADMIN_NOTIFY_KEY
# متغیرهای پشتیبانی‌شده در زمان اجرا:
#   ADMIN_NOTIFY_KEY     ← کلید کانال اعلان (required)
#   ZARINPAL_FORCE_REAL=1   ← اجبار درگاه واقعی زرین‌پال (اختیاری، توصیه‌شده در پرود)
#   NAKHL_EXPOSE_DEV_CODE=1 ← نمایش کد OTP در پاسخ API (فقط تست! در پرود ممنوع)

# پروداکشن نیازی به این‌ها ندارد (حذف شدند): DATABASE_URL، مسیر uploads محلی،
# NAKHL_NOTIFY_URL (DO داخلی جای آن را می‌گیرد)، ADMIN_PASSWORD (seed با SQL).

# اسرار سرویس‌های خارجی (پیامک/زرین‌پال/OpenRouter) از پنل مدیریت
# (/nk-admin → تنظیمات) داخل دیتابیس D1 ذخیره می‌شوند، نه به‌صورت env.

# ═══════════════ Docker / VPS (دایرکت‌ادمین) ═════════════════════════════════
# برای دیپلوی داکر، فایل مرجع جداگانه‌ای وجود دارد:
#   cp docker/env.example .env     →  راهنمای کامل: DOCKER-DEPLOY-FA.md
# (این فایل .env فقط برای `next dev` سندباکس/لوکال است.)
