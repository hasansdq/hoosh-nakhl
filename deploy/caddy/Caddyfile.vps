# =============================================================================
# Nakhl Restaurant — Caddy config for a bare VPS (no Docker)
# -----------------------------------------------------------------------------
# Install Caddy (https://caddyserver.com/docs/install) then:
#   sudo cp deploy/caddy/Caddyfile.vps /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Replace nakhl.example.com with your domain (DNS A-record → server IP).
# Caddy obtains and renews the Let's Encrypt certificate automatically.
# =============================================================================

nakhl.example.com {
	encode zstd gzip

	# realtime channel → notify-service on localhost
	handle /rt/* {
		uri strip_prefix /rt
		reverse_proxy 127.0.0.1:3003
	}

	# everything else → Next.js standalone
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
