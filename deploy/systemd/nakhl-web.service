# =============================================================================
# Nakhl Restaurant — systemd unit (Next.js standalone web server)
# Copy to: /etc/systemd/system/nakhl-web.service   then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nakhl-web
#   journalctl -u nakhl-web -f          # follow logs
#
# Adjust WorkingDirectory + Environment values for your server.
# =============================================================================
[Unit]
Description=Nakhl Restaurant — Next.js web server (standalone)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nakhl
ExecStart=/usr/bin/node /opt/nakhl/.next/standalone/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# ← REQUIRED: absolute path to the SQLite database
Environment=DATABASE_URL=file:/opt/nakhl/db/custom.db
# ← REQUIRED: strong random secret (openssl rand -hex 32)
Environment=AUTH_SECRET=CHANGE-ME
# ← REQUIRED: must match nakhl-notify.service
Environment=ADMIN_NOTIFY_KEY=CHANGE-ME
Environment=NAKHL_NOTIFY_URL=http://127.0.0.1:3003/emit
Environment=NAKHL_SUPERVISE_DEV=0
Environment=ZARINPAL_FORCE_REAL=1

# hardening (relax if /opt/nakhl needs broader access)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/nakhl/db /opt/nakhl/public/uploads

[Install]
WantedBy=multi-user.target
